# ==========================================================================
# 代码注释 Agent .env 配置模板（v2.4.0 多 Provider 支持）
# 使用方法：复制本文件为 .env，填写对应 Provider 的 API Key
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Provider / Model 全局默认（启动时读取，运行时可通过 UI 切换）
# --------------------------------------------------------------------------
# PROVIDER 可选值：
#   deepseek  - DeepSeek（默认，推荐）
#   openai    - OpenAI 官方 (GPT 系列)
#   azure     - Azure OpenAI Service（需自定义 BASE_URL）
#   dashscope - 阿里百炼 / 阿里云 DashScope (Qwen 系列)
#   moonshot  - 月之暗面 / Moonshot AI (Kimi 系列)
#   custom    - 自定义 OpenAI 兼容网关（Ollama / vLLM / OneAPI / LM Studio 等）
PROVIDER=deepseek

# MODEL：不填则取对应 Provider 的第一个默认模型
# DeepSeek 可选：deepseek-chat（默认）| deepseek-reasoner
# OpenAI   可选：gpt-4o-mini（默认）| gpt-4o | gpt-4.1 | gpt-3.5-turbo
# Azure    可选：gpt-4o-mini（默认）| gpt-4o | gpt-35-turbo（需与 Portal 部署名一致）
# DashScope可选：qwen-plus（默认）| qwen-turbo | qwen-max
# Moonshot 可选：moonshot-v1-8k（默认）| moonshot-v1-32k | moonshot-v1-128k
# Custom   可选：通过 CUSTOM_MODEL_NAME 指定
MODEL=deepseek-chat

# BASE_URL：仅 PROVIDER=azure 或 custom 时生效；其他 Provider 使用内置默认
# Azure  示例：https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# Custom 示例：http://localhost:8000/v1（Ollama/vLLM 默认）
# BASE_URL=

# CUSTOM_MODEL_NAME：仅 PROVIDER=custom 生效，自由填写网关支持的模型名
# CUSTOM_MODEL_NAME=qwen2.5-72b-instruct

# --------------------------------------------------------------------------
# 2. 各 Provider 的 API Key（按优先级读取，第一个非空生效）
#    强烈建议只填写你实际使用的 Provider，其余留空即可
# --------------------------------------------------------------------------

# --- DeepSeek ---
# 官网：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- OpenAI 官方 ---
# 官网：https://platform.openai.com
# 注意：DeepSeek 未设置时，代码也会尝试用 OPENAI_API_KEY 作回退
OPENAI_API_KEY=sk-your-openai-key-here

# --- Azure OpenAI Service ---
# 官网：https://portal.azure.com → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-api-key-here

# --- 阿里百炼 / DashScope ---
# 官网：https://bailian.console.aliyun.com → API Key 管理
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
ALIBABA_API_KEY=

# --- 月之暗面 / Moonshot AI (Kimi) ---
# 官网：https://platform.moonshot.cn
MOONSHOT_API_KEY=sk-your-moonshot-key-here
KIMI_API_KEY=
